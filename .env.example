# Supabase (the same project as Conidolly). Local: `supabase status` inside estudio-coni prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only the E2E cleanup uses the service role; the app itself writes as the signed-in user.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_SERVICE_ROLE_KEY=

# The only addresses the app signs in: the code is emailed there. Nobody types an email.
CORREO_CONI=coni@estudio.test
CORREO_WAV=wav@estudio.test

# Cloudflare R2, the same bucket as Conidolly (browsers upload straight to it with presigned URLs).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Local E2E only: replaces the R2 address with a fake S3 on this machine (refused when VERCEL is set).
R2_ENDPOINT=

# Trigger.dev project of Conidolly: the app starts "procesar-material" after an upload.
TRIGGER_SECRET_KEY=
# Local E2E only: writes the runs it would start to a file instead of calling Trigger.dev (refused when VERCEL is set).
DISPARO_DE_PRUEBA=
DISPARO_DE_PRUEBA_ARCHIVO=
